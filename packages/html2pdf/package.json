{
  "name": "html2pdf-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:linux": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile binaries/html2pdf-x86_64-unknown-linux-gnu",
    "build:windows": "bun build src/cli.ts --compile --target=bun-windows-x64 --outfile binaries/html2pdf-x86_64-pc-windows-msvc.exe",
    "build:mac-arm": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile binaries/html2pdf-aarch64-apple-darwin"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
